# ─────────────────────────────────────────────────────────────
#  유튜브 음악 채널 자동화 — 환경변수 설정 파일
#  이 파일을 복사해서 .env 로 저장한 뒤 키를 입력하세요.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ① YouTube Data API v3 (필수 — 채널 분석, 경쟁 레이더)
#    발급: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=

# ② Gemini API (권장 — AI 분석, 정성 점수, 역설계, 썸네일 프롬프트)
#    발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ③ OpenAI API (선택 — Gemini 대체 또는 비교 모드)
#    발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ④ Pexels API (선택 — 스톡 미디어 검색)
#    발급: https://www.pexels.com/api/
PEXELS_API_KEY=

# ─── Streamlit Cloud 배포 시 ─────────────────────────────────
# Streamlit Cloud는 .env 를 읽지 않습니다.
# 대신 https://share.streamlit.io 앱 설정 → Secrets 메뉴에서
# 아래 형식으로 입력하세요:
#
# YOUTUBE_API_KEY = "AIza..."
# GEMINI_API_KEY  = "AIza..."
# OPENAI_API_KEY  = "sk-..."
# PEXELS_API_KEY  = "..."
