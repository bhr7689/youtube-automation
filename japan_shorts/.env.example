# ─────────────────────────────────────────────
#  일본쇼츠 자동 프로그램 — 환경변수
#  이 파일을 복사해 .env 로 저장하고 키를 넣으세요.  cp .env.example .env
# ─────────────────────────────────────────────

# YouTube Data API v3 (필수 — 실시간 정확 데이터)
#   발급: https://console.cloud.google.com → APIs & Services → Credentials
#   비우면 데모(예시) 데이터로 화면만 시현됩니다.
YOUTUBE_API_KEY=

# 서버 포트 (기본 8600)
PORT=8600
