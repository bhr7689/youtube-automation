# ─────────────────────────────────────────────────────────────
#  경쟁 채널 인텔리전스 레이더 — 환경변수
#  cp .env.example .env  후 키 입력
# ─────────────────────────────────────────────────────────────

# YouTube Data API v3 (필수)
# 발급: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=

# Gemini API (AI 분석 필요 시)
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Streamlit Cloud 배포 시 ──
# .env 대신 앱 설정 → Secrets 에 아래 형식으로 입력:
#
# YOUTUBE_API_KEY = "AIza..."
# GEMINI_API_KEY  = "AIza..."
